# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection (matches the local `choco install postgresql16` setup)
DATABASE_URL="postgresql://postgres:devpassword123@localhost:5432/ventilator_management"

# NextAuth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Seeded on first `npm run db:seed` run, only if no admin user exists yet.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
